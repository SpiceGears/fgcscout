# Generate long, unique values before production deployment.
FGCSCOUT_ADMIN_API_KEY=replace-with-at-least-32-random-characters
MONGO_ROOT_USERNAME=fgcscout_root
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
MONGO_APP_DATABASE=fgcscout
MONGO_APP_USERNAME=fgcscout_app
MONGO_APP_PASSWORD=replace-with-a-different-long-random-password

# Public deployment. Caddy obtains HTTPS certificates automatically for a real domain.
# Host ports used by the existing reverse proxy/tunnel. Container ports stay 80/443.
FGCSCOUT_HTTP_PORT=6080
FGCSCOUT_HTTPS_PORT=6443
CADDY_SITE_ADDRESS=fgcscout.example.com
FGCSCOUT_FRONTEND_ORIGIN=https://fgcscout.example.com

# Leave empty when the browser should use the same public origin through Caddy.
NEXT_PUBLIC_API_URL=

# Required information for the privacy notice.
NEXT_PUBLIC_SITE_OPERATOR=Your name or organization
NEXT_PUBLIC_PRIVACY_CONTACT=privacy@example.com
NEXT_PUBLIC_OPERATOR_ADDRESS=City and country or registered address
NEXT_PUBLIC_HOSTING_PROVIDER=Hosting provider, country
